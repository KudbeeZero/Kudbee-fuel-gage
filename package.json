{
  "name": "kudbee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "format": "prettier --write .",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "start:agent": "node services/monitor/agent.js",
    "monitor:db-budget": "node scripts/monitor-db-budget.mjs",
    "sim:traffic": "node scripts/traffic-sim.mjs",
    "verify:flow": "node scripts/verify-flow.mjs",
    "phase:readiness": "node scripts/verify-next-phase.mjs",
    "phase:readiness:full": "node scripts/verify-next-phase.mjs --full",
    "phase:task": "node scripts/model-task-packet.mjs",
    "verify:browser-matrix": "node scripts/verify-browser-matrix.mjs",
    "phase:govern": "node scripts/phase-governor.mjs",
    "phase:ops-audit": "node scripts/verify-operating-model.mjs",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify:secrets": "node scripts/verify-secret-hygiene.mjs",
    "verify:agent-contracts": "node scripts/verify-agent-contracts.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "verify:learning-protocol": "node scripts/verify-learning-protocol.mjs",
    "verify:ci-smoke": "node scripts/verify-ci-smoke.mjs",
    "verify:crypto": "node scripts/verify-crypto-runtime.mjs",
    "verify:box-web": "node scripts/box-web-verify.mjs",
    "deploy-check": "tsx scripts/deploy-check.ts",
    "ingest:topology": "tsx scripts/ingest-topology.ts",
    "heroku-postbuild": "turbo run build --concurrency=4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "tar": "7.5.19",
    "postcss": "^8.5.18"
  },
  "license": "Proprietary",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@upstash/box": "^0.6.0",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
