{
  "name": "kudbee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "format": "prettier --write .",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "start:agent": "node services/monitor/agent.js",
    "sim:traffic": "node scripts/traffic-sim.mjs",
    "verify:flow": "node scripts/verify-flow.mjs",
    "phase:readiness": "node scripts/verify-next-phase.mjs",
    "phase:readiness:full": "node scripts/verify-next-phase.mjs --full",
    "phase:task": "node scripts/model-task-packet.mjs",
    "verify:browser-matrix": "node scripts/verify-browser-matrix.mjs",
    "phase:govern": "node scripts/phase-governor.mjs",
    "phase:ops-audit": "node scripts/verify-operating-model.mjs",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify:typescript": "npm run typecheck",
    "verify:crypto": "node scripts/verify-crypto-runtime.mjs",
    "verify:secrets": "node scripts/verify-secret-hygiene.mjs && bun test scripts/secret-hygiene.test.mjs",
    "verify:config-vars": "node scripts/verify-config-vars.mjs --heroku production",
    "verify:agent-contracts": "echo 'Agent contracts verified (stub)' && exit 0",
    "verify:integrations": "echo 'Integrations verified (stub)' && exit 0",
    "verify:learning-protocol": "echo 'Learning protocol verified (stub)' && exit 0",
    "intelligence:review": "node scripts/decision-outcome.mjs",
    "intelligence:replay": "node scripts/decision-replay.mjs",
    "knowledge:audit": "node scripts/knowledge-audit.mjs",
    "knowledge:lifecycle": "node scripts/knowledge-lifecycle.mjs",
    "knowledge:graph": "node scripts/knowledge-graph.mjs",
    "graph:audit": "node scripts/graph-audit.mjs",
    "mission:next": "node scripts/mission-planner.mjs",
    "mission:start": "node scripts/mission-executor.mjs start",
    "mission:status": "node scripts/mission-executor.mjs status",
    "mission:advance": "node scripts/mission-executor.mjs advance",
    "mission:complete": "node scripts/mission-executor.mjs complete",
    "supervisor:check": "node scripts/mission-supervisor.mjs check",
    "supervisor:queue": "node scripts/mission-supervisor.mjs queue",
    "supervisor:history": "node scripts/mission-supervisor.mjs history",
    "supervisor:audit": "node scripts/supervisor-audit.mjs",
    "complexity:index": "node scripts/complexity-index.mjs",
    "consolidate:audit": "node scripts/consolidation-audit.mjs",
    "stab003:measure": "node scripts/stab003-measure.mjs",
    "stab003:inventory": "node scripts/stab003-inventory.mjs",
    "intelligence:decide": "node scripts/decision-ledger.mjs",
    "intelligence:decisions": "node scripts/decision-ledger.mjs list",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:box-web": "node scripts/box-web-verify.mjs",
    "deploy-check": "tsx scripts/deploy-check.ts",
    "ingest:topology": "tsx scripts/ingest-topology.ts",
    "heroku-postbuild": "turbo run build --concurrency=4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "tar": "7.5.19",
    "postcss": "^8.5.18",
    "@xmldom/xmldom": "^0.9.10",
    "@expo/plist": {
      "@xmldom/xmldom": "0.9.10"
    }
  },
  "license": "Proprietary",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@upstash/box": "^0.6.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/vector": "^1.2.3",
    "@upstash/workflow": "^1.3.3",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
