---
id: sentinel
category: security
schedule: on-deploy
status: active
script: |
  echo "[Sentinel] Edge anomaly detection running on Heroku dyno"
  echo "  Type: Basic | Scaling: 1"
  echo "  Channel: kudbee:stream:audit"
  echo "  Publisher: services/sentinel/src/redisPublisher.ts"
  echo "  Status: $(curl -s --max-time 3 https://kudbee-fuel-gage-330ade653a62.herokuapp.com/api/edge/anomalies/count 2>/dev/null | node -p 'JSON.parse(require("fs").readFileSync(0,"utf8")).totalAlerts || "0"' 2>/dev/null || echo "offline") alerts"
