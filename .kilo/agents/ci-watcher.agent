---
category: verification
description: CI gate watcher — runs verification suite, detects regressions, decodes failures
triggers: verify, test, build, e2e, typecheck, regression
schedule: on-deploy
actions: recall, decode, update, run
uuid: ver-001
memoryId: verification-patterns
created: 2026-07-27
---
set -eu

echo "[ci-watcher] Running bounded verification smoke..."

echo ""
echo "  Gate 1: Agent contracts"
npm run verify:agent-contracts

echo ""
echo "  Gate 2: Integration availability"
npm run verify:integrations

echo ""
echo "  Gate 3: Node crypto runtime"
npm run verify:crypto

echo ""
echo "  Gate 4: Learning protocol"
npm run verify:learning-protocol

echo ""
echo "  Gate 5: E2E smoke (provider writes disabled)"
if [ "${E2E_ALLOW_DATABASE_WRITES:-0}" = "1" ]; then
  echo "  E2E_ALLOW_DATABASE_WRITES=1; running full database-writing E2E"
  node scripts/verify-e2e.mjs
else
  echo "  E2E_ALLOW_DATABASE_WRITES is not 1; running isolated bounded smoke"
  node scripts/verify-e2e.mjs --smoke
fi

if [ "${CI_WATCHER_FULL:-0}" = "1" ]; then
  echo ""
  echo "  Extended gates: Typecheck"
  npm run typecheck

  echo ""
  echo "  Extended gates: Tests"
  (cd services/lib && npx -y bun test test/)

  echo ""
  echo "  Extended gates: Build"
  npm run build --workspace=@kudbee/web
else
  echo ""
  echo "  Extended gates skipped by default; set CI_WATCHER_FULL=1 for local extended checks"
fi

echo ""
echo "  Gate 5: Knowledge health"
node scripts/snippet-agent.mjs health

node scripts/agents.mjs decide ci-watcher "verification_complete" "bounded contract, integration, learning, smoke, and knowledge gates executed"
