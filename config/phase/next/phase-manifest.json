{
  "phase": "security-durability-foundation",
  "version": 2,
  "status": "ready-to-start",
  "governancePolicy": "config/phase/next/governance-policy.json",
  "sopManifest": "config/phase/next/sop-manifest.json",
  "models": {
    "deepseek-v4": { "role": "backend-security-architecture", "taskFile": "config/phase/next/deepseek-v4.tasks.json" },
    "qwen-3.6-pro": { "role": "frontend-product-verification", "taskFile": "config/phase/next/qwen-3.6-pro.tasks.json" }
  },
  "sharedRules": [
    "Use a dedicated worktree per model task",
    "Do not edit production secrets",
    "Do not treat localStorage as authentication",
    "Do not claim a check passed without current command evidence",
    "Record changed files, tests, risks, and rollback steps",
    "Human approval is required for authentication, tenant, data, and deployment changes"
  ],
  "requiredCommands": [
    "npm run typecheck",
    "bun test",
    "node scripts/verify-system-integrity.mjs",
    "node scripts/verify-e2e.mjs",
    "node scripts/verify-agents.mjs",
    "node scripts/verify-drift.mjs",
    "node scripts/verify-resilience.mjs",
    "node scripts/verify-think-loop.mjs",
    "node scripts/verify-governance-loop.mjs",
    "node scripts/browser-verifier.mjs"
    ,"npm run verify:browser-matrix"
  ],
  "releaseBlockers": [
    "Replace browser-only authentication",
    "Derive tenant and role from the authenticated principal",
    "Remove production fallback secrets",
    "Remove silent production in-memory write fallback",
    "Make worker task claims crash-safe",
    "Persist and tenant-scope audit anchors",
    "Remove fabricated operational metrics",
    "Pass authorization matrix and tenant-isolation tests"
  ]
}
