# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REACT_APP_API_URL: Base URL of the deployed ingestion/backend (AWS/EC2).
# Point the Control Tower dashboard at your AWS/EC2 backend, e.g.:
#   REACT_APP_API_URL="https://your-ec2-host.example.com"
# Leave empty to use same-origin relative paths (default for the monolith deploy).
REACT_APP_API_URL=""

# CORS_ALLOW_ORIGINS: Comma-separated list of origins allowed to call the API.
# Use "*" for open access, or a specific origin like the frontend URL.
CORS_ALLOW_ORIGINS="*"

# STREAM_SECRET: HMAC signing key for SSE stream ticket authentication.
# The /api/auth/stream-ticket endpoint uses this to sign single-use
# tokens. Clients present the ticket as a query parameter on SSE URLs.
# STREAM_SECRET="kudbee-stream-secret"

# -------- INGESTION AUTH BOUNDARY (Phase 4) --------
# KUDBEE_AUTH_BOUNDARY: 'required' (or NODE_ENV=production) → protected routes
#   (agents/governance/memory/think/interceptor/tools/terminal/admin/audit-vault)
#   require authentication (401). 'dev-open' (default, non-production) →
#   non-high-risk protected routes stay open for local dev, but high-risk
#   terminal/tools routes still require auth.
# KUDBEE_AUTH_BOUNDARY="required"
# KUDBEE_DEV_OPEN: set "true" to explicitly open high-risk terminal/tools routes
#   for local development only. Never set in production.
# KUDBEE_DEV_OPEN="false"
# SESSION_SECRET: HMAC signing key for server-issued HttpOnly browser sessions.
# Store only in the hosting provider's secret manager.
# SESSION_SECRET="replace-with-random-session-secret"

# -------- DATABASE --------
# DATABASE_URL: Neon Postgres connection string. Required for persistence.
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/kudbee?sslmode=require"

# -------- REDIS --------
# REDIS_URL: Primary Redis for UI telemetry, SSE pub/sub, state.
# REDIS_URL="redis://127.0.0.1:6379"
# UPSTASH_REDIS_REST_URL: REST endpoint used by the Redis MCP and serverless paths.
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN: Read/write token for server-side use only.
# UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
# UPSTASH_BOX_API_KEY: Optional Box API key for remote browser verification.
# UPSTASH_BOX_API_KEY="replace-with-upstash-box-api-key"
# -------- RUNTIME --------
# PORT: HTTP server port. Set explicitly on AWS/EC2.
# PORT=3000
# NODE_ENV: Runtime environment. Set to "production" on AWS/EC2.
# NODE_ENV=production

# -------- LLM PROVIDERS --------
# GROQ_API_KEY: API key for Groq LPU inference.
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL: Groq model override (default: llama-3.1-8b-instant)
# VLLM_BASE_URL: vLLM inference server URL.
# VLLM_API_KEY: vLLM API key.

# -------- BUDGET & RATE --------
# MONTHLY_BUDGET_USD: Hard cap on cumulative LLM spend per month (default: 50).
# MONTHLY_BUDGET_USD=50
# SAMPLE_RATE: Statistical sampling rate (default: 1).
# CRUCIBLE_ENABLED: Feature flag for Crucible agent (true/false).
# CRUCIBLE_ENABLED=true

# -------- REDIS (WORKER) --------
# REDIS_WORKER_URL: Dedicated Redis for background worker queues (BRPOP/BLPOP polling).
# Provisioned to isolate high-volume polling from the main Redis instance.
# Falls back to REDIS_URL when not set.
# REDIS_WORKER_URL="rediss://default:password@hostname.upstash.io:6379"

# -------- AGENT AUTH --------
# EDGE_AGENT_PASS: Authentication pass for edge agents.
# SENTINEL_AGENT_PASS: Authentication pass for sentinel agent.
# SENTINEL_MODE: Sentinel operational mode (monitor, enforce, disabled).

# -------- CACHING --------
# LANGCACHE_ENDPOINT: Redis LangCache REST endpoint.
# LANGCACHE_API_KEY: Bearer token for LangCache semantic caching.
# LANGCACHE_API_KEY="lc_..."
