#!/usr/bin/env bash
# .githooks/pre-commit — Protocol Guardian pre-commit enforcement.
# Installed via: git config core.hooksPath .githooks
set -euo pipefail

# Rule 3: refuse commits on main without explicit hotfix approval.
BRANCH="$(git branch --show-current 2>/dev/null || true)"
if [ "$BRANCH" = "main" ]; then
  # Allow only merge/squash markers (auto-generated by GitHub merges).
  if ! git diff --cached --name-only | grep -q '^\.github/workflows\|^\.kilo/memory'; then
    echo "⛔ PROTOCOL GUARDIAN: commits on 'main' are forbidden (Rule 1/3)."
    echo "   Create a feature branch: git checkout -b feature/<objective>"
    exit 1
  fi
fi

# Rule 4: require an objective lock for feature work.
if [ "$BRANCH" != "main" ]; then
  if [ ! -f .kilo/objective-lock.json ]; then
    echo "⛔ PROTOCOL GUARDIAN: no objective lock declared (Rule 4)."
    echo "   Run: node scripts/protocol-guard.mjs objective <id> [prNumber]"
    exit 1
  fi
fi

exit 0
